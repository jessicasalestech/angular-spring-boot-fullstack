# Normalize line endings to LF in the repository on every OS.
* text=auto

# Source files
*.java text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.xml text eol=lf

# Binary
*.ico binary
*.png binary
*.jar binary